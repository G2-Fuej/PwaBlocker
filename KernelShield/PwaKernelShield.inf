; Independent auxiliary driver. It does not replace MessageTransfer.sys.

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=09/26/2026,1.0.0.0
CatalogFile=PwaKernelShield.cat
PnpLockdown=1

[DefaultInstall.NTamd64]
CopyFiles=DriverCopy

[DefaultInstall.NTamd64.Services]
AddService=PwaKernelShield,0x00000002,PwaKernelShield_Service

[DriverCopy]
PwaKernelShield.sys

[SourceDisksNames]
1=%DiskName%,,

[SourceDisksFiles]
PwaKernelShield.sys=1

[DestinationDirs]
DriverCopy=12

[PwaKernelShield_Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\PwaKernelShield.sys

[Strings]
ProviderName="PwaBlocker"
ServiceName="PwaKernelShield"
DiskName="PwaKernelShield installation media"
